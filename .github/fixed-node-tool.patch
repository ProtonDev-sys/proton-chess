+        args = Namespace(
+            nodes=2048,
+            move_time=None,
+            base_seconds=None,
+            increment=0.0,
+            watchdog_grace=2.0,
+        )
+        control = estimate_elo.build_time_control(args)
+        self.assertEqual(control.nodes_per_move, 2048)
+        with self.assertRaisesRegex(ValueError, "nodes must be positive"):
+            args.nodes = 0
+            estimate_elo.build_time_control(args)
